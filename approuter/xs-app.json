{
  "welcomeFile": "index.html",
  "authenticationMethod": "none",
  "destinations": [
    {
      "name": "ltvf-backend",
      "logoutPath": "/api/logout",
      "logoutMethod": "GET"
    }
  ],
  "routes": [
    {
      "source": "^/api/(.*)$",
      "destination": "ltvf-backend",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^(.*)$",
      "localDir": "dist",
      "authenticationType": "none"
    }
  ]
}

