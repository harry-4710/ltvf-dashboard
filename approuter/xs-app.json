{
  "welcomeFile": "index.html",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/api/(.*)$",
      "destination": "ltvf-backend",
      "authenticationType": "none",
      "csrfProtection": false,
      "httpMethods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    },
    {
      "source": "^(.*)$",
      "localDir": "dist",
      "authenticationType": "none"
    }
  ]
}

