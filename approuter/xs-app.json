{
  "welcomeFile": "/ltvfdashboard/index.html",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/api/(.*)$",
      "destination": "ltvf-backend",
      "authenticationType": "none"
    },
    {
      "source": "^/ltvfdashboard/(.*)$",
      "target": "/ltvfdashboard/$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "none"
    },
    {
      "source": "^(.*)$",
      "target": "/ltvfdashboard/$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "none"
    }
  ]
}
