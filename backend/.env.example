# =============================================================================
# LTVF Dashboard Backend — Environment Variables
# Copy this file to .env and fill in your values.
# On Render: set these in Dashboard → ltvf-backend → Environment.
# NEVER commit .env to git — it is in .gitignore.
# =============================================================================

# ── CORS ──────────────────────────────────────────────────────────────────────
# Lock to your Vercel frontend URL in production. Use * for local dev only.
ALLOWED_ORIGINS=https://ltvf-dashboard.vercel.app

# =============================================================================
# METHOD B — SAP BTP Cloud Connector (Recommended for on-premise SAP)
# =============================================================================
# These 4 variables are required for the "Fetch from SAP BTP" button to work.
# Get them from your BTP Destination Service key (see SETUP_BTP.md for steps).
# Verify your setup using: GET /api/sap/test

# XSUAA OAuth2 token endpoint
# Source: BTP cockpit → Instances → Destination service key → "url" + "/oauth/token"
BTP_TOKEN_URL=https://<subaccount-subdomain>.authentication.us10.hana.ondemand.com/oauth/token

# Destination Service client credentials
# Source: BTP cockpit → Instances → Destination service key → "clientid" and "clientsecret"
BTP_DEST_CLIENT_ID=<destination-service-clientid>
BTP_DEST_CLIENT_SECRET=<destination-service-clientsecret>

# Destination Service base URL
# Source: BTP cockpit → Instances → Destination service key → "uri"
BTP_DEST_SVC_URL=https://destination-configuration.cfapps.us10.hana.ondemand.com

# Connectivity Service on-premise proxy
# Source: BTP cockpit → Instances → Connectivity service key → "onpremise_proxy_host/port"
BTP_CONN_PROXY_HOST=connectivity.cf.sap.hana.ondemand.com
BTP_CONN_PROXY_PORT=20003

# Name of the BTP Destination created in BTP cockpit → Connectivity → Destinations
# Must match exactly (case-sensitive). Create it with ProxyType=OnPremise.
SAP_DESTINATION_NAME=LTVF_ONPREMISE

# OData service path on the SAP system (default is correct for standard CNVLTVF3)
SAP_ODATA_SERVICE=/sap/opu/odata/sap/CNVLTVF3_SRV

# OData entity set name (default is correct for standard CNVLTVF3)
ODATA_ENTITY_SET=LTVFResultSet

# =============================================================================
# OData Field Name Overrides (only set if your BASIS uses non-standard names)
# =============================================================================
# Defaults shown below — only override if GET /api/sap/test returns empty/wrong data.
# ODATA_FIELD_TEST_NAME=Description
# ODATA_FIELD_RATE_PCT=MatchRate
# ODATA_FIELD_DIFF=DiffCount
# ODATA_FIELD_MISSING=MissingCount
# ODATA_FIELD_UNEXPECTED=UnexpectedCount
# ODATA_FIELD_EQUAL=EqualCount
# ODATA_FIELD_SOURCE=SourceVolume
# ODATA_FIELD_TARGET=TargetVolume
# ODATA_FIELD_LEVEL=HierarchyLevel
# ODATA_FIELD_PARENT_ID=ParentNodeId
# ODATA_FIELD_NODE_ID=NodeId
# ODATA_FIELD_IS_GROUP=IsGroup

# =============================================================================
# METHOD A — Direct SAP Connection (only if SAP is network-reachable from backend)
# =============================================================================
SAP_BASE_URL=https://<sap-host>:<port>
SAP_CLIENT=100
SAP_USER=<sap-service-account-username>
SAP_PASSWORD=<sap-service-account-password>

# =============================================================================
# METHOD C — SharePoint Scheduled Export
# =============================================================================
# Set USE_MOCK_SCHEDULED=true to use sample data without real SharePoint credentials.
USE_MOCK_SCHEDULED=false
SHAREPOINT_TENANT_ID=<azure-directory-tenant-id>
SHAREPOINT_CLIENT_ID=<azure-app-client-id>
SHAREPOINT_CLIENT_SECRET=<azure-app-client-secret>
SHAREPOINT_SITE_NAME=<sharepoint-site-name>
SHAREPOINT_FOLDER_PATH=/SAP Exports
SHAREPOINT_FILENAME=ltvf_latest.xlsx

# =============================================================================
# Email Alerting (optional)
# =============================================================================
# Sends an HTML alert when overall match rate drops below the warn threshold.
# Leave SMTP_HOST blank to disable alerting silently.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-sender@example.com
SMTP_PASS=your-smtp-password
# Comma-separated recipients. Set to "off" to disable explicitly.
ALERT_EMAIL_TO=team@example.com

# =============================================================================
# SAP Analytics Cloud Embed (set in Vercel env vars, not here)
# =============================================================================
VITE_SAC_STORY_URL=

