# ── SAP Direct Connection ───────────────────────────────────────────────────
SAP_BASE_URL=https://<sap-host>:<port>
SAP_CLIENT=100
SAP_USER=<sap-service-account>
SAP_PASSWORD=<password>
SAP_ODATA_SERVICE=/sap/opu/odata/sap/CNVLTVF3_SRV

# ── LTVF Backend Fallback (if SAP direct/BTP not available) ─────────────────
LTVF_BACKEND_URL=https://ltvf-backend.cfapps.us10-003.hana.ondemand.com

# ── Optional: BTP Destination approach (alternative to direct) ─────────────
# BTP_TOKEN_URL=https://<subdomain>.authentication.sap.hana.ondemand.com/oauth/token
# BTP_DEST_CLIENT_ID=<clientid>
# BTP_DEST_CLIENT_SECRET=<clientsecret>
# BTP_DEST_SVC_URL=https://destination-configuration.cfapps.sap.hana.ondemand.com
# BTP_CONN_PROXY_HOST=connectivity.cf.sap.hana.ondemand.com
# BTP_CONN_PROXY_PORT=20003
# SAP_DESTINATION_NAME=LTVF_ONPREMISE

# ── HTTP/SSE Transport (Joule Hub mode) ─────────────────────────────────────
# MCP_TRANSPORT=http              # "http" enables HTTP+SSE, default is "stdio"
# PORT=3001                       # HTTP listen port (CF sets this automatically)
# ALLOWED_ORIGINS=https://hub.joule.only.sap,https://d73dca5etrial-dev-ltvf-approuter.cfapps.us10-003.hana.ondemand.com

# ── XSUAA Auth (HTTP mode only) ─────────────────────────────────────────────
# In CF: bind ltvf-xsuaa service → VCAP_SERVICES is auto-populated, no vars needed.
# For local dev without XSUAA:
XSUAA_DISABLED=true
# For local dev WITH XSUAA (manual config):
# XSUAA_URL=https://<subdomain>.authentication.us10.hana.ondemand.com
# XSUAA_CLIENT_ID=<clientid>
# XSUAA_CLIENT_SECRET=<clientsecret>
# XSUAA_APP_NAME=ltvf-mcp-server

