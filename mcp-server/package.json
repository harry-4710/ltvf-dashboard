{
  "name": "ltvf-mcp-server",
  "version": "2.0.0",
  "description": "MCP server for LTVF Dashboard — stdio (Claude Code) and HTTP+SSE (Joule Hub) transport",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:http": "MCP_TRANSPORT=http node index.js",
    "start:http:dev": "MCP_TRANSPORT=http XSUAA_DISABLED=true node index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@sap/xsenv": "^5.6.1",
    "@sap/xssec": "^3.6.2",
    "express": "^4.22.3"
  },
  "engines": {
    "node": "22.x.x"
  }
}
